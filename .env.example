# Primary AI Tutor Provider (ollama, openai, anthropic, openrouter, gemini)
AI_PROVIDER=ollama


# ─── Ollama (Local) Configuration ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45

# ─── OpenAI Configuration ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Anthropic Claude Configuration ────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── OpenRouter Configuration ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Recommended for Create Course quality (free). Paid: nvidia/nemotron-3-super-120b-a12b
# Weak free models (e.g. cohere/north-mini-code:free) often produce vague 'as in the video' steps.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Google Gemini Configuration ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Create Course quality self-review loop (OpenRouter-owned)
# Higher = more revise attempts after FAIL reviews. Default 8.
CREATE_COURSE_QUALITY_MAX_TRIES=8
# Set to 1 only as last-resort local planner when no AI provider is configured.
# CREATE_COURSE_HEURISTIC_FALLBACK=0
