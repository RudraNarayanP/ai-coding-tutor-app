      "starter_code": "import string\n\ndef normalize_tokens(tokens):\n    # TODO\n    pass\n",
      "solution_code": "import string\n\ndef normalize_tokens(tokens):\n    out = []\n    for t in tokens:\n        t = t.lower().strip(string.punctuation)\n        if t:\n            out.append(t)\n    return out\n",
      "tests": [
        {
          "name": "test_normalize_tokens",
          "unittest_code": "def test_normalize_tokens(self):\n    self.assertEqual(normalize_tokens(['Hello!', 'WORLD.']), ['hello', 'world'])\n",
          "required": true
        }
      ],
