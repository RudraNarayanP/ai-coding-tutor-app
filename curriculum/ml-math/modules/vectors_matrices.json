        "vectors-matrices"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute vector dot products"
      ],
      "starter_code": "def dot(a, b):\n    # TODO: return sum of a[i]*b[i]\n    pass\n",
      "solution_code": "def dot(a, b):\n    return sum(x * y for x, y in zip(a, b))\n",
      "tests": [
        {
          "name": "test_dot",
          "unittest_code": "def test_dot(self):\n    self.assertEqual(dot([1, 2, 3], [4, 5, 6]), 32)\n    self.assertEqual(dot([0, 1], [1, 0]), 0)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_dot"
        ]
      }
