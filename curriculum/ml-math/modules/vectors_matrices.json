    {
      "id": "matrix-multiply",
      "title": "4. Matrix-Vector Multiply",
      "description": "Implement `matvec(A, x)` multiplying matrix A by vector x.",
      "order": 4,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "practice",
      "section_id": "sec-mlmath-1",
      "section_title": "Section 1: Math & Data for ML",
