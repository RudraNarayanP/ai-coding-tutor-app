    {
      "id": "vectors-checkpoint",
      "title": "5. Checkpoint: Cosine Similarity",
      "description": "Implement `cosine_sim(a, b)` = dot/(||a|| ||b||). Return 0 if either norm is 0.",
      "order": 5,
      "difficulty": "intermediate",
      "duration_minutes": 10,
      "type": "checkpoint",
      "section_id": "sec-mlmath-1",
      "section_title": "Section 1: Math & Data for ML",
      "concepts": [
        "vectors-matrices"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute cosine similarity"
      ],
      "starter_code": "import math\n\ndef cosine_sim(a, b):\n    # TODO\n    pass\n",
      "solution_code": "import math\n\ndef cosine_sim(a, b):\n    dot = sum(x * y for x, y in zip(a, b))\n    na = math.sqrt(sum(x * x for x in a))\n    nb = math.sqrt(sum(x * x for x in b))\n    if na == 0 or nb == 0:\n        return 0.0\n    return dot / (na * nb)\n",
      "tests": [
        {
          "name": "test_cosine_sim",
          "unittest_code": "def test_cosine_sim(self):\n    self.assertAlmostEqual(cosine_sim([1, 0], [1, 0]), 1.0)\n    self.assertAlmostEqual(cosine_sim([1, 0], [0, 1]), 0.0)\n    self.assertEqual(cosine_sim([0, 0], [1, 2]), 0.0)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_cosine_sim"
        ]
      },
