      "type": "learn",
      "section_id": "sec-mlmath-1",
      "section_title": "Section 1: Math & Data for ML",
      "concepts": [
        "stats-summaries"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute median"
      ],
      "starter_code": "def median(xs):\n    # TODO\n    pass\n",
      "solution_code": "def median(xs):\n    s = sorted(xs)\n    n = len(s)\n    mid = n // 2\n    if n % 2:\n        return float(s[mid])\n    return (s[mid - 1] + s[mid]) / 2\n",
      "tests": [
        {
          "name": "test_median",
          "unittest_code": "def test_median(self):\n    self.assertEqual(median([3, 1, 2]), 2.0)\n    self.assertEqual(median([1, 2, 3, 4]), 2.5)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_median"
        ]
