    {
      "id": "stats-checkpoint",
      "title": "5. Checkpoint: Pearson Correlation",
      "description": "Implement `pearson(xs, ys)` for equal-length lists. Return 0 if either std is 0.",
      "order": 15,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "checkpoint",
      "section_id": "sec-mlmath-1",
      "section_title": "Section 1: Math & Data for ML",
      "concepts": [
        "stats-summaries"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute Pearson correlation"
      ],
      "starter_code": "import math\n\ndef pearson(xs, ys):\n    # TODO\n    pass\n",
      "solution_code": "import math\n\ndef pearson(xs, ys):\n    n = len(xs)\n    mx = sum(xs) / n\n    my = sum(ys) / n\n    num = sum((x - mx) * (y - my) for x, y in zip(xs, ys))\n    dx = math.sqrt(sum((x - mx) ** 2 for x in xs))\n    dy = math.sqrt(sum((y - my) ** 2 for y in ys))\n    if dx == 0 or dy == 0:\n        return 0.0\n    return num / (dx * dy)\n",
      "tests": [
        {
          "name": "test_pearson",
          "unittest_code": "def test_pearson(self):\n    self.assertAlmostEqual(pearson([1, 2, 3], [2, 4, 6]), 1.0)\n    self.assertEqual(pearson([1, 1, 1], [1, 2, 3]), 0.0)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_pearson"
        ]
      }
    }
