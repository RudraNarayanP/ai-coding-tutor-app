      "id": "metrics-mae",
      "title": "1. MAE",
      "description": "Implement `mae(y_true, y_pred)`.",
      "order": 11,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "learn",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute mean absolute error"
      ],
      "starter_code": "def mae(y_true, y_pred):\n    # TODO\n    pass\n",
      "solution_code": "def mae(y_true, y_pred):\n    return sum(abs(a - b) for a, b in zip(y_true, y_pred)) / len(y_true)\n",
      "tests": [
        {
          "name": "test_mae",
          "unittest_code": "def test_mae(self):\n    self.assertAlmostEqual(mae([1, 3], [2, 3]), 0.5)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_mae"
        ]
      }
    },
    {
      "id": "metrics-bce",
      "title": "2. Binary Cross-Entropy",
      "description": "Implement `bce(y, p)` for single label y in {0,1} and prob p clipped to [1e-9, 1-1e-9].",
      "order": 12,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "learn",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute binary cross-entropy"
      ],
      "starter_code": "import math\n\ndef bce(y, p):\n    # TODO\n    pass\n",
      "solution_code": "import math\n\ndef bce(y, p):\n    p = min(max(p, 1e-9), 1 - 1e-9)\n    return -(y * math.log(p) + (1 - y) * math.log(1 - p))\n",
      "tests": [
        {
          "name": "test_bce",
          "unittest_code": "def test_bce(self):\n    self.assertAlmostEqual(bce(1, 0.8), -__import__('math').log(0.8))\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_bce"
        ]
      }
    },
    {
      "id": "metrics-f1",
      "title": "3. F1 Score",
      "description": "Implement `f1(precision, recall)`. Return 0 if both 0.",
      "order": 13,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "challenge",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute F1 from precision/recall"
      ],
      "starter_code": "def f1(precision, recall):\n    # TODO\n    pass\n",
      "solution_code": "def f1(precision, recall):\n    if precision + recall == 0:\n        return 0.0\n    return 2 * precision * recall / (precision + recall)\n",
      "tests": [
        {
          "name": "test_f1",
          "unittest_code": "def test_f1(self):\n    self.assertAlmostEqual(f1(0.5, 0.5), 0.5)\n    self.assertEqual(f1(0, 0), 0.0)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_f1"
        ]
      }
    },
    {
      "id": "metrics-confusion",
      "title": "4. Confusion Counts (Practice)",
      "description": "Implement `confusion(y_true, y_pred)` returning dict with tp,fp,tn,fn for positive=1.",
      "order": 14,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "practice",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Build a confusion matrix"
      ],
      "starter_code": "def confusion(y_true, y_pred):\n    # TODO\n    pass\n",
      "solution_code": "def confusion(y_true, y_pred):\n    tp = fp = tn = fn = 0\n    for yt, yp in zip(y_true, y_pred):\n        if yt == 1 and yp == 1:\n            tp += 1\n        elif yt == 0 and yp == 1:\n            fp += 1\n        elif yt == 0 and yp == 0:\n            tn += 1\n        else:\n            fn += 1\n    return {'tp': tp, 'fp': fp, 'tn': tn, 'fn': fn}\n",
      "tests": [
        {
          "name": "test_confusion",
          "unittest_code": "def test_confusion(self):\n    c = confusion([1, 0, 1, 0], [1, 1, 0, 0])\n    self.assertEqual(c, {'tp': 1, 'fp': 1, 'tn': 1, 'fn': 1})\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_confusion"
        ]
      }
    },
    {
      "id": "metrics-checkpoint",
      "title": "5. Checkpoint: Threshold Sweep",
      "description": "Implement `best_threshold(scores, labels)` choosing threshold in scores that maximizes accuracy. Ties \u2192 lower threshold.",
      "order": 15,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "checkpoint",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Tune decision thresholds"
      ],
      "starter_code": "def best_threshold(scores, labels):\n    # TODO\n    pass\n",
      "solution_code": "def best_threshold(scores, labels):\n    candidates = sorted(set(scores))\n    best_thr, best_acc = candidates[0], -1.0\n    for thr in candidates:\n        preds = [1 if s >= thr else 0 for s in scores]\n        acc = sum(p == y for p, y in zip(preds, labels)) / len(labels)\n        if acc > best_acc or (acc == best_acc and thr < best_thr):\n            best_acc = acc\n            best_thr = thr\n    return best_thr\n",
      "tests": [
        {
          "name": "test_best_threshold",
          "unittest_code": "def test_best_threshold(self):\n    thr = best_threshold([0.1, 0.4, 0.6, 0.9], [0, 0, 1, 1])\n    self.assertEqual(thr, 0.6)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_best_threshold"
        ]
      }
    }
  ]
