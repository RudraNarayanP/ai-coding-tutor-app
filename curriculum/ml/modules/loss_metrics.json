    {
      "id": "metrics-bce",
      "title": "2. Binary Cross-Entropy",
      "description": "Implement `bce(y, p)` for single label y in {0,1} and prob p clipped to [1e-9, 1-1e-9].",
      "order": 12,
      "difficulty": "intermediate",
      "duration_minutes": 5,
      "type": "learn",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute binary cross-entropy"
      ],
      "starter_code": "import math\n\ndef bce(y, p):\n    # TODO\n    pass\n",
      "solution_code": "import math\n\ndef bce(y, p):\n    p = min(max(p, 1e-9), 1 - 1e-9)\n    return -(y * math.log(p) + (1 - y) * math.log(1 - p))\n",
      "tests": [
        {
          "name": "test_bce",
          "unittest_code": "def test_bce(self):\n    self.assertAlmostEqual(bce(1, 0.8), -__import__('math').log(0.8))\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_bce"
        ]
      },
      "source": {
        "name": "Google Machine Learning Crash Course — Logistic regression: Loss and regularization — Log Loss formula -1/N Σ[y log y' + (1-y) log(1-y')]",
        "url": "https://developers.google.com/machine-learning/crash-course/logistic-regression/loss-regularization",
        "license": "CC BY 4.0 (Google Machine Learning Crash Course)"
      },
      "xp_reward": 10
