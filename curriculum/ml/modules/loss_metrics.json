      "id": "metrics-mae",
      "title": "1. MAE",
      "description": "Implement `mae(y_true, y_pred)` returning the mean of the absolute differences (mean absolute error). The test checks mae([1, 3], [2, 3]) == 0.5.",
      "order": 11,
      "difficulty": "intermediate",
      "duration_minutes": 5,
      "type": "learn",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute mean absolute error"
      ],
      "starter_code": "def mae(y_true, y_pred):\n    # TODO\n    pass\n",
      "solution_code": "def mae(y_true, y_pred):\n    return sum(abs(a - b) for a, b in zip(y_true, y_pred)) / len(y_true)\n",
      "tests": [
        {
          "name": "test_mae",
          "unittest_code": "def test_mae(self):\n    self.assertAlmostEqual(mae([1, 3], [2, 3]), 0.5)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_mae"
        ]
      },
      "source": {
