    {
      "id": "metrics-confusion",
      "title": "4. Confusion Counts (Practice)",
      "description": "Implement `confusion(y_true, y_pred)` returning dict with tp,fp,tn,fn for positive=1.",
      "order": 14,
      "difficulty": "intermediate",
      "duration_minutes": 6,
      "type": "practice",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Build a confusion matrix"
      ],
      "starter_code": "def confusion(y_true, y_pred):\n    # TODO\n    pass\n",
      "solution_code": "def confusion(y_true, y_pred):\n    tp = fp = tn = fn = 0\n    for yt, yp in zip(y_true, y_pred):\n        if yt == 1 and yp == 1:\n            tp += 1\n        elif yt == 0 and yp == 1:\n            fp += 1\n        elif yt == 0 and yp == 0:\n            tn += 1\n        else:\n            fn += 1\n    return {'tp': tp, 'fp': fp, 'tn': tn, 'fn': fn}\n",
      "tests": [
        {
          "name": "test_confusion",
          "unittest_code": "def test_confusion(self):\n    c = confusion([1, 0, 1, 0], [1, 1, 0, 0])\n    self.assertEqual(c, {'tp': 1, 'fp': 1, 'tn': 1, 'fn': 1})\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_confusion"
        ]
      },
      "source": {
        "name": "scikit-learn User Guide — 3.4 Metrics and scoring — classification metrics (confusion_matrix)",
        "url": "https://scikit-learn.org/stable/modules/model_evaluation.html",
        "license": "BSD 3-Clause (scikit-learn documentation)"
      },
      "xp_reward": 15,
      "sublessons": [
        {
          "id": "confusion-match-sub",
          "title": "Match each count",
          "order": 1,
          "exercises": [
            {
              "id": "confusion-match-1",
              "type": "matching",
              "question": "`confusion(y_true, y_pred)` counts four cases with positive = 1. Match each case to the branch that produces it.",
              "pairs": [
                {
                  "left": "true positive",
                  "right": "actual 1 and predicted 1"
                },
                {
                  "left": "false positive",
                  "right": "actual 0 but predicted 1"
                },
                {
                  "left": "true negative",
                  "right": "actual 0 and predicted 0"
                },
                {
                  "left": "false negative",
                  "right": "actual 1 but predicted 0"
                }
              ],
              "correct_answer": {
                "true positive": "actual 1 and predicted 1",
                "false positive": "actual 0 but predicted 1",
                "true negative": "actual 0 and predicted 0",
                "false negative": "actual 1 but predicted 0"
              },
              "explanation": "The first word says whether the prediction was right; the second says which class was predicted.",
              "xp_reward": 10
            }
          ]
        }
      ]
    },
    {
      "id": "metrics-checkpoint",
      "title": "5. Checkpoint: Threshold Sweep",
      "description": "Implement `best_threshold(scores, labels)` choosing threshold in scores that maximizes accuracy. Ties → lower threshold.",
      "order": 15,
      "difficulty": "intermediate",
      "duration_minutes": 10,
      "type": "checkpoint",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Tune decision thresholds"
      ],
      "starter_code": "def best_threshold(scores, labels):\n    # TODO\n    pass\n",
      "solution_code": "def best_threshold(scores, labels):\n    candidates = sorted(set(scores))\n    best_thr, best_acc = candidates[0], -1.0\n    for thr in candidates:\n        preds = [1 if s >= thr else 0 for s in scores]\n        acc = sum(p == y for p, y in zip(preds, labels)) / len(labels)\n        if acc > best_acc or (acc == best_acc and thr < best_thr):\n            best_acc = acc\n            best_thr = thr\n    return best_thr\n",
      "tests": [
        {
          "name": "test_best_threshold",
          "unittest_code": "def test_best_threshold(self):\n    thr = best_threshold([0.1, 0.4, 0.6, 0.9], [0, 0, 1, 1])\n    self.assertEqual(thr, 0.6)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_best_threshold"
        ]
      },
