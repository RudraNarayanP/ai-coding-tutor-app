      "id": "metrics-f1",
      "title": "3. F1 Score",
      "description": "Implement `f1(precision, recall)`. Return 0 if both 0.",
      "order": 13,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "challenge",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "loss-metrics"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Compute F1 from precision/recall"
      ],
      "starter_code": "def f1(precision, recall):\n    # TODO\n    pass\n",
      "solution_code": "def f1(precision, recall):\n    if precision + recall == 0:\n        return 0.0\n    return 2 * precision * recall / (precision + recall)\n",
      "tests": [
        {
          "name": "test_f1",
          "unittest_code": "def test_f1(self):\n    self.assertAlmostEqual(f1(0.5, 0.5), 0.5)\n    self.assertEqual(f1(0, 0), 0.0)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_f1"
        ]
      },
      "source": {
        "name": "scikit-learn User Guide — 3.4 Metrics and scoring — precision, recall and F1 (harmonic mean)",
