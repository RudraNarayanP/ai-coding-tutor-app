      "id": "overfit-early-stop",
      "title": "3. Early Stopping",
      "description": "Implement `early_stop_epoch(val_losses, patience)` returning first epoch index to stop (0-based) or last index if never.",
      "order": 18,
      "difficulty": "intermediate",
      "duration_minutes": 8,
      "type": "challenge",
      "section_id": "sec-ml-1",
      "section_title": "Section 1: ML Foundations",
      "concepts": [
        "overfitting-regularization"
      ],
      "prerequisites": [],
      "learning_objectives": [
        "Simulate early stopping"
      ],
      "starter_code": "def early_stop_epoch(val_losses, patience):\n    # TODO\n    pass\n",
      "solution_code": "def early_stop_epoch(val_losses, patience):\n    best = float('inf')\n    wait = 0\n    for i, loss in enumerate(val_losses):\n        if loss < best:\n            best = loss\n            wait = 0\n        else:\n            wait += 1\n            if wait >= patience:\n                return i\n    return len(val_losses) - 1\n",
      "tests": [
        {
          "name": "test_early_stop",
          "unittest_code": "def test_early_stop(self):\n    self.assertEqual(early_stop_epoch([1.0, 0.5, 0.6, 0.7], 2), 3)\n    self.assertEqual(early_stop_epoch([1.0, 0.8, 0.6], 5), 2)\n",
          "required": true
        }
      ],
      "completion_requirements": {
        "required_test_names": [
          "test_early_stop"
        ]
      }
    },
